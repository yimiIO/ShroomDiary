{
  "name": "shroom-api",
  "version": "1.0.0",
  "private": true,
  "description": "Independent API for Shroom diary, cards and social discovery",
  "main": "src/server.js",
  "bin": {
    "shroom-codex": "scripts/shroom-codex.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "test:integration": "node test/integration.js",
    "seed:editorial-cards": "node migrate/editorial_cards.js",
    "backfill:memory": "node migrate/backfill_memory.js",
    "backfill:inquiries": "node migrate/backfill_inquiry_candidates.js",
    "compare:wellbeing-models": "node migrate/compare_wellbeing_models.js",
    "migrate:cos-images": "node migrate/cos_images.js",
    "repair:oversized-images": "node migrate/repair_oversized_cos_images.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "express": "^5.1.0",
    "ffmpeg-static": "5.3.0",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "sharp": "^0.35.4"
  }
}
