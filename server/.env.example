# Required
DATABASE_URL=postgres://shroom:change-me@127.0.0.1:5432/shroom
TOKEN_SECRET=replace-with-a-long-random-secret
# Dedicated key for AES-256-GCM encryption of private financial ledger payloads.
# Use a random value in production and back it up securely; changing it makes
# previously stored financial payloads unreadable.
FINANCIAL_DATA_ENCRYPTION_KEY=replace-with-an-independent-long-random-secret
# Keep disabled until the privacy notice names the current AI processor and
# its financial-text processing/retention terms have been reviewed.
FINANCIAL_AI_IMPORT_ENABLED=false
# User-facing legal name of the processor receiving financial import text.
# Required before FINANCIAL_AI_IMPORT_ENABLED can take effect.
FINANCIAL_AI_PROCESSOR_NAME=

# Human access to the management console. Keep the username and the scrypt
# password hash on the server only; never place the plaintext password here.
ADMIN_CONSOLE_USERNAME=
ADMIN_CONSOLE_PASSWORD_HASH=

# HTTP and sessions
PORT=3102
PUBLIC_ORIGIN=http://localhost:3102
ALLOWED_ORIGINS=http://localhost:8080
ACCESS_TOKEN_SECONDS=7200
REFRESH_TOKEN_DAYS=90
# Allows browser tabs that refresh together to finish the same rotation safely.
REFRESH_REUSE_GRACE_SECONDS=30
UPLOAD_DIR=./uploads

# AI (optional, OpenAI-compatible chat completions)
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=120000
AI_USD_CNY_RATE=7.2

# Daily review. The worker creates and sends a private review only after the
# user verifies an email address and explicitly enables 22:00 delivery.
DAILY_REVIEW_WORKER_ENABLED=true
DAILY_REVIEW_WORKER_INTERVAL_MS=60000
DAILY_REVIEW_EMAIL_HOUR=22
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURE=true
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_FROM="Shroom <no-reply@example.com>"

# Billing. Keep disabled until the legal entity, invoice entity and WeChat Pay
# credentials have been verified. `preview` enables wallets and feature gates
# without accepting payment; `live` also enables real WeChat Pay orders.
BILLING_MODE=disabled
BILLING_MERCHANT_LABEL=suyetiyu
BILLING_MERCHANT_LEGAL_NAME="海口澎湃体育文化有限公司"
BILLING_INVOICE_LEGAL_NAME="海口澎湃体育文化有限公司"
BILLING_MERCHANT_TAX_ID=91460000MAKMYQ5J7G
BILLING_MERCHANT_ADDRESS="海南省海口市琼山区国兴街道办文政社区居委会国兴大道4号海航豪庭一期C19地块4#楼10层（集中办公区）"
BILLING_CUSTOMER_SERVICE="邮箱：contact@extremenomad.org；微信：evox077"
BILLING_CUSTOMER_SERVICE_EMAIL=contact@extremenomad.org
BILLING_ICP_QUALIFICATION=
# Required only when a native app is published; it does not block H5 collection.
BILLING_APP_FILING_NUMBER=
# Only confirm after the operator has reviewed qualifications, published terms,
# price display, refund operations and the WeChat merchant business category.
BILLING_LEGAL_REVIEW_CONFIRMED=false
BILLING_AI_CHARGE_MULTIPLIER=2.5
BILLING_AI_MINIMUM_START_POINT_CENTS=1

# WeChat Pay server credentials. The production-proven path is V2 JSAPI inside
# personal WeChat. Mini Program requestPayment stays blocked for virtual services.
WECHAT_PAY_PROTOCOL=v2_jsapi
WECHAT_PAY_JSAPI_ENABLED=false
WECHAT_PAY_H5_ENABLED=false
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MERCHANT_LEGAL_NAME="海口澎湃体育文化有限公司"
WECHAT_PAY_APP_ID=
WECHAT_OAUTH_APP_ID=
WECHAT_OAUTH_APP_SECRET=
WECHAT_PAY_API_V2_KEY=
WECHAT_PAY_MERCHANT_CERT_PATH=
WECHAT_PAY_MERCHANT_SERIAL=
WECHAT_PAY_PRIVATE_KEY_PATH=
# The following API v3 values are only used when WECHAT_PAY_PROTOCOL=v3_h5.
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_TIMEOUT_MS=15000
# Public-key verification is preferred; platform certificate is a fallback.
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY_PATH=
WECHAT_PAY_PLATFORM_CERT_PATH=
WECHAT_PAY_NOTIFY_URL=https://shroom.surfplus.xyz/api/billing/v1/payments/wechat/notify
WECHAT_PAY_REFUND_NOTIFY_URL=https://shroom.surfplus.xyz/api/billing/v1/refunds/wechat/notify

# Embeddings (optional, OpenAI-compatible)
EMBEDDING_PROVIDER=compatible
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=0
EMBEDDING_TIMEOUT_MS=60000
EMBEDDING_BATCH_SIZE=32

# Speech recognition (optional)
ASR_PROVIDER=
ASR_API_BASE_URL=
ASR_API_KEY=
ASR_MODEL=
ASR_LANGUAGE=zh
VOLC_ASR_ENDPOINT=https://openspeech.bytedance.com/api/v3/auc/bigmodel/recognize/flash
VOLC_ASR_API_KEY=
VOLC_ASR_APP_KEY=
VOLC_ASR_ACCESS_KEY=
VOLC_ASR_RESOURCE_ID=volc.bigasr.auc_turbo

# Private Tencent COS image storage (optional in development)
COS_BUCKET=
COS_REGION=ap-guangzhou
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REQUIRED_FOR_IMAGES=false
IMAGE_MAX_PIXELS=40000000
IMAGE_MAX_DIMENSION=1600

# Background workers
MEMORY_WORKER_ENABLED=true
MEMORY_WORKER_INTERVAL_MS=3000
FRIEND_SYNC_WORKER_ENABLED=true
FRIEND_SYNC_WORKER_INTERVAL_MS=3000

# Compound statistics source (optional)
COMPOUND_STATS_URL=
COMPOUND_STATS_USERNAME=
COMPOUND_STATS_PASSWORD=
COMPOUND_STATS_TIMEOUT_MS=8000
